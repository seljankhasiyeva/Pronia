@using Pronia1.Models
@model List<Slider>;
@{
    int count = 0;
}
<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <a asp-action="create" class="btn btn-success">Add Slide</a>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    No
                                </th>
                                <th>
                                    İmage
                                </th>
                                <th>
                                    Title
                                </th>
                                <th>
                                    Order
                                </th>
                                <th>
                                    Settings
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Slider slide in Model)
                            {
                                count++;
                                <tr>
                                    <td class="py-1">
                                        @count
                                    </td>
                                    <td>
                                        <img src="~/assets/images/website-images/@slide.Image" alt="" />
                                    </td>
                                    <td>
										@slide.Title
                                    </td>
                                    <td>
                                        @slide.Order
                                    </td>
                                    <td>
                                        <a asp-area="Admin"
                                           asp-controller="Slider" asp-action="Update" asp-route-id="@slide.Id" class="btn btn-warning">Update</a>
                                        <a asp-area="Admin"
                                           asp-controller="Slider"
                                           asp-action="Delete"
                                           asp-route-id="@slide.Id"
                                           class="btn btn-danger">
                                            Delete
                                        </a>
                                        <a class="btn btn-primary">Detail</a>
                                    </td>
                                </tr>
                            }


                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>