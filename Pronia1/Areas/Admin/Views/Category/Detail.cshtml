@using Pronia1.Models
@model List<Category>
<div class="card" style="width: 18rem;">
    <div class="card-body">
        @foreach (Category category in Model)
        {
            <h5 class="card-title">@category.Name</h5>
            <h6 class="card-subtitle mb-2 text-body-secondary">@category.Products</h6>
        }
    </div>
</div>